<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/var/log/fsm-sync/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>/var/log/fsm-sync/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="c8y.microservice.sap.fsm" level="DEBUG"/>
    <logger name="org.springframework.web.client" level="DEBUG"/>

    <!-- Suppress noisy SDK debug logs -->
    <logger name="com.cumulocity.microservice.subscription.repository.impl.CurrentMicroserviceRepository" level="INFO"/>
    <logger name="com.cumulocity.microservice.subscription.repository.impl.LegacyMicroserviceRepository" level="INFO"/>
    <logger name="com.cumulocity.microservice.subscription.repository.MicroserviceSubscriptionsRepository" level="INFO"/>


    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <logger name="c8y.microservice.sap.fsm" level="DEBUG"/>
    <logger name="org.springframework.web.client" level="DEBUG"/>
</configuration>
